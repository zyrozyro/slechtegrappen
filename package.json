{
  "name": "slechtegrappen",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create slechtegrappen-db",
    "db:init": "wrangler d1 execute slechtegrappen-db --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute slechtegrappen-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
